{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no dependencies: the site build uses the Python standard library only'",
  "buildCommand": "python3 tools/build_site.py",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    { "source": "/worlds/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/img/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] }
  ]
}
